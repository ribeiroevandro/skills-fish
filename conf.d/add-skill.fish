# Cores padrão do add-skill. Valores já definidos pelo usuário são preservados.
set -q add_skill_color_unselected; or set -g add_skill_color_unselected "#6c7086"
set -q add_skill_color_header; or set -g add_skill_color_header "#89b4fa"
set -q add_skill_color_selected; or set -g add_skill_color_selected "#94e2d5"
set -q add_skill_color_error; or set -g add_skill_color_error "#f38ba8"
set -q add_skill_color_title; or set -g add_skill_color_title "#74c7ec"
